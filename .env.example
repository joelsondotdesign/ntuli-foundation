# Neon Postgres — use the POOLED connection string, not the direct one.
# Serverless functions open and close connections per request; the pooler
# is what stops that exhausting the database's connection limit.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# From the Vercel dashboard (Storage → Blob) — only needed once deploying.
# Without it, media uploads fall back to local disk storage in development.
BLOB_READ_WRITE_TOKEN=
